---
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { SITE, absUrl } from '../lib/site'

interface Props {
  title: string
  description: string
  /** Site-relative path with trailing slash, e.g. "/emoji-combiner/". Used for canonical + OG. */
  path: string
  ogImage?: string
  /** JSON-LD document (already wrapped with @context / @graph). */
  schema?: Record<string, unknown>
  noindex?: boolean
}

const { title, description, path, ogImage = SITE.ogImage, schema, noindex = false } = Astro.props
const canonical = absUrl(path)
const ogImageAbs = absUrl(ogImage)
const gtagId = import.meta.env.PUBLIC_GTAG_ID
const gaEnabled = Boolean(gtagId) && gtagId !== 'XXX'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#faf9fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16141d" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content={SITE.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <script is:inline>
      // Apply saved/system color scheme before paint to avoid flashing.
      (() => {
        const stored = localStorage.getItem('color-scheme')
        const dark = stored === 'dark' || (stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
      })()
    </script>

    {gaEnabled && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`}></script>
    )}
    {gaEnabled && (
      <script is:inline define:vars={{ gtagId }}>
        window.dataLayer = window.dataLayer || []
        function gtag(){dataLayer.push(arguments)}
        gtag('js', new Date())
        gtag('config', gtagId)
      </script>
    )}
  </head>
  <body>
    <SiteHeader currentPath={path} />
    <slot />
    <SiteFooter />
  </body>
</html>
