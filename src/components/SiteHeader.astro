---
interface Props { currentPath: string }
const { currentPath } = Astro.props

const nav = [
  { href: '/', label: 'Emoji Maker' },
  { href: '/emoji-combiner/', label: 'Combiner' },
  { href: '/emoji-kitchen/', label: 'Emoji Kitchen' },
  { href: '/random-emoji-generator/', label: 'Random' },
  { href: '/emoji-combinations/', label: 'Combos' },
  { href: '/guides/how-to-make-custom-emojis/', label: 'Guide' },
]
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="EmojiMaker home">
      <img src="/favicon.svg" alt="" width="26" height="26" />
      EmojiMaker
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      {nav.map((item) => (
        <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"/></svg>
    </button>
  </div>
</header>
<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = !document.documentElement.classList.contains('dark')
    document.documentElement.classList.toggle('dark', dark)
    localStorage.setItem('color-scheme', dark ? 'dark' : 'light')
  })
</script>
