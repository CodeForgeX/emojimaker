---
import BaseLayout from '../layouts/BaseLayout.astro'
import Faq from '../components/Faq.astro'
import EmojiKitchenBrowser from '../components/islands/EmojiKitchenBrowser'
import { graph, organization, article, faqPage, breadcrumb, webApplication } from '../lib/schema'

const path = '/emoji-kitchen/'
const title = 'Emoji Kitchen — Browse 147,000+ Combos Online (Any Device)'
const description =
  'Browse Google’s Emoji Kitchen online: pick two emojis, see the official mashup sticker, then copy or download it. Works on iPhone and desktop — no Gboard needed.'

const faqItems = [
  {
    q: 'What is Emoji Kitchen?',
    a: 'Emoji Kitchen is a Google feature that merges two emojis into a single hand-designed sticker. It launched in Gboard in 2020 and now covers 147,000+ combinations across 619 emojis. Every mashup is a real illustration drawn by Google’s designers, which is why the results look so polished.',
  },
  {
    q: 'How do I use Emoji Kitchen on iPhone?',
    a: 'There is no Gboard keyboard integration on iOS, but you don’t need it: the browser above works in Safari on any iPhone — pick two emojis, then copy or download the sticker. Google Search’s “emoji kitchen” widget is another option.',
  },
  {
    q: 'How do I get Emoji Kitchen on Android?',
    a: 'Install Google’s Gboard keyboard, open any chat, tap an emoji and mashup suggestions appear above the keyboard. Or skip the keyboard entirely and use the browser on this page — same stickers, and you can download them as PNG files.',
  },
  {
    q: 'Why do some emoji pairs have no combination?',
    a: 'Google only ships mashups its designers have drawn. When you pick your first emoji above, unsupported partners grey out automatically. If a pair you want doesn’t exist, our emoji combiner can overlay any two emojis into one image instead.',
  },
  {
    q: 'How do I save or copy Emoji Kitchen stickers?',
    a: 'In the browser above, “Copy sticker” puts the PNG on your clipboard and “Download PNG” saves the full-size transparent image — ready to use as a reaction meme or upload as a custom emoji in Discord or Slack.',
  },
  {
    q: 'Is Emoji Kitchen AI-generated?',
    a: 'No. Emoji Kitchen combinations are pre-designed illustrations, not AI images. That’s different from Apple’s Genmoji, which generates emoji-style images with AI on supported iPhones.',
  },
]

const schema = graph(
  organization(),
  webApplication({
    path,
    name: 'Emoji Kitchen Browser',
    description:
      'Browse and download all 147,000+ Google Emoji Kitchen combinations in any browser — pick two emojis, see the official mashup, copy or save it.',
    features: [
      'All 147,000+ official Emoji Kitchen combinations',
      'Works on iPhone, Android and desktop — no Gboard required',
      'Copy sticker to clipboard or download transparent PNG',
      'Shareable combo links',
      'Random combo discovery',
    ],
  }),
  article({
    path,
    headline: 'Emoji Kitchen: Browse Every Combo Online, and How It Works',
    description,
    datePublished: '2026-07-29',
    dateModified: '2026-08-02',
  }),
  faqPage(path, faqItems.map(({ q, a }) => ({ q, a: a.replace(/<[^>]+>/g, '') }))),
  breadcrumb([{ name: 'Home', path: '/' }, { name: 'Emoji Kitchen', path }]),
)
---
<BaseLayout title={title} description={description} path={path} schema={schema}>
  <main class="page container">
    <section class="hero">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › Emoji Kitchen</nav>
      <h1>Emoji Kitchen Browser: Every Google Mashup, On Any Device</h1>
      <p class="lede">
        Pick two emojis and see Google's official Emoji Kitchen sticker — then copy it or download
        the transparent PNG. Works in any browser: iPhone, Android, desktop. No Gboard needed.
      </p>
      <ul class="hero-badges" aria-label="Highlights">
        <li>147,000+ combos</li>
        <li>Official Google artwork</li>
        <li>Copy or download PNG</li>
        <li>Free, no sign-up</li>
      </ul>
    </section>

    <EmojiKitchenBrowser client:load />

    <section class="prose prose-page">
      <h2>What is Emoji Kitchen?</h2>
      <p>
        Emoji Kitchen is a feature from Google that "cooks" two emojis into a single mashup sticker —
        a cowboy-hat ghost, a heart-eyed cactus, a crying fire. Every combination is a real
        illustration drawn by Google's design team, which is why the results look far better than a
        simple overlay. It debuted in <strong>Gboard</strong> in 2020 and has grown to more than
        147,000 combinations across 619 emojis — all of them browsable above.
      </p>

      <h2>Three ways to use Emoji Kitchen</h2>
      <h3>1. Right here, in any browser</h3>
      <p>
        The browser at the top of this page uses the same official artwork. Pick two emojis (or hit
        <em>Random combo</em>), then copy the sticker or download it as a transparent PNG — something
        Gboard itself doesn't offer. Share a combo by copying the page URL.
      </p>
      <h3>2. On Android, inside Gboard</h3>
      <p>
        Install Gboard, open any messaging app, tap the emoji button and select an emoji. Mashup
        suggestions appear above the keyboard; tap one to send it as a sticker.
      </p>
      <h3>3. On Google Search</h3>
      <p>
        Search <em>“emoji kitchen”</em> on Google and tap <em>Get cooking</em> to mix emojis inside
        the search page and copy the result.
      </p>

      <div class="callout">
        <p>
          <strong>Want a pair Google hasn't drawn?</strong> The <a href="/emoji-combiner/">emoji
          combiner</a> overlays <em>any</em> two emojis into one downloadable image — and the
          <a href="/">emoji maker</a> lets you build a custom emoji from parts.
        </p>
      </div>
    </section>

    <Faq items={faqItems} />

    <section class="related">
      <div class="section-head">
        <p class="eyebrow">Keep creating</p>
        <h2>Related tools and guides</h2>
      </div>
      <ul>
        <li><a href="/emoji-combiner/"><b>Emoji Combiner</b><span>Overlay any two emojis — no pair restrictions.</span></a></li>
        <li><a href="/"><b>Emoji Maker</b><span>Design a custom emoji from scratch with Fluent-style parts.</span></a></li>
        <li><a href="/genmoji-online/"><b>Genmoji Online</b><span>Apple's AI emoji, explained — and what to use on other devices.</span></a></li>
        <li><a href="/emoji-combinations/"><b>Emoji Combinations</b><span>Ready-made combos to copy for bios and captions.</span></a></li>
      </ul>
    </section>
  </main>
</BaseLayout>
