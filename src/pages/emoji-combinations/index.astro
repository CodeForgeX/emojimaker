---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Faq from '../../components/Faq.astro'
import { COMBO_CATEGORIES } from '../../data/combinations'
import { graph, organization, article, faqPage, breadcrumb } from '../../lib/schema'

const path = '/emoji-combinations/'
const title = 'Emoji Combinations to Copy: Aesthetic, Cute & Funny Combos'
const description =
  'Tap to copy emoji combinations: aesthetic, cute, funny, Christmas and Halloween combos for bios, captions and usernames — plus a tool to merge any two emojis.'

const faqItems = [
  {
    q: 'What are emoji combinations?',
    a: 'Emoji combinations (or “emoji combos”) are small sets of emojis — usually 2 to 5 — arranged to create one vibe or mini-story, like 🌷🍓🎀 for a soft aesthetic or 💀☕ for dark-humor mornings. People paste them into bios, usernames, captions and comments.',
  },
  {
    q: 'How do I copy an emoji combination?',
    a: 'Tap or click any combo on these pages — it copies to your clipboard automatically. Then paste it anywhere: Instagram bio, TikTok caption, Discord status, WhatsApp name.',
  },
  {
    q: 'Can I make my own emoji combination into a single image?',
    a: 'Yes — with the free emoji combiner you can overlay two emojis into one PNG, which works as a sticker or custom emoji. For a fully custom face, try the emoji maker.',
  },
  {
    q: 'Do emoji combos look the same on every phone?',
    a: 'Mostly. Each platform draws emojis in its own style (Apple, Google, Samsung differ slightly), so a combo can shift in tone — but the meaning and arrangement stay intact. Avoid very new emojis if your audience may be on old devices.',
  },
]

const schema = graph(
  organization(),
  article({
    path,
    headline: 'Emoji Combinations to Copy: Aesthetic, Cute, Funny and Seasonal Combos',
    description,
    datePublished: '2026-07-29',
    dateModified: '2026-08-02',
  }),
  faqPage(path, faqItems),
  breadcrumb([{ name: 'Home', path: '/' }, { name: 'Emoji Combinations', path }]),
)
---
<BaseLayout title={title} description={description} path={path} schema={schema}>
  <main class="page container">
    <section class="hero">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › Emoji Combinations</nav>
      <h1>Emoji Combinations to Copy &amp; Paste</h1>
      <p class="lede">
        Aesthetic, cute, funny and seasonal emoji combos — organized by vibe, each with dozens of
        tap-to-copy combinations for your bio, caption or username.
      </p>
    </section>

    <section class="related">
      <div class="section-head">
        <h2>Browse by vibe</h2>
      </div>
      <ul>
        {COMBO_CATEGORIES.map((cat) => (
          <li>
            <a href={`/emoji-combinations/${cat.slug}/`}>
              <b>{cat.name} emoji combinations</b>
              <span>{cat.sections.reduce((n, s) => n + s.combos.length, 0)} combos · e.g. {cat.sections[0].combos.slice(0, 3).join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {COMBO_CATEGORIES.map((cat) => (
      <section>
        <div class="section-head">
          <h2><a href={`/emoji-combinations/${cat.slug}/`}>{cat.name}</a> — quick picks</h2>
        </div>
        <div class="combo-grid">
          {cat.sections[0].combos.slice(0, 8).map((c) => (
            <button class="combo js-copy" data-copy={c} title="Click to copy">{c}</button>
          ))}
          <a class="combo" href={`/emoji-combinations/${cat.slug}/`} style="text-decoration:none;font-size:0.9rem;display:inline-flex;align-items:center">All {cat.name.toLowerCase()} →</a>
        </div>
      </section>
    ))}

    <div class="callout">
      <p>
        <strong>Want one image instead of three characters?</strong> Merge any two emojis into a
        single transparent PNG with the free <a href="/emoji-combiner/">emoji combiner</a>, or browse
        Google's official mashups in the <a href="/emoji-kitchen/">Emoji Kitchen browser</a>.
      </p>
    </div>

    <Faq items={faqItems} />

    <section class="related">
      <div class="section-head">
        <p class="eyebrow">Keep creating</p>
        <h2>More emoji tools</h2>
      </div>
      <ul>
        <li><a href="/emoji-combiner/"><b>Emoji Combiner</b><span>Turn a combo into one downloadable image.</span></a></li>
        <li><a href="/random-emoji-generator/"><b>Random Emoji Generator</b><span>Roll random emojis until a combo clicks.</span></a></li>
        <li><a href="/"><b>Emoji Maker</b><span>Design a fully custom emoji from parts.</span></a></li>
      </ul>
    </section>
  </main>

  <script is:inline>
    document.querySelectorAll('.js-copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy)
          window.gtag?.('event', 'copy', { tool: 'combinations', content_type: 'combo' })
          btn.classList.add('copied')
          const prev = btn.textContent
          btn.textContent = 'Copied!'
          setTimeout(() => { btn.textContent = prev; btn.classList.remove('copied') }, 900)
        } catch {}
      })
    })
  </script>
</BaseLayout>
